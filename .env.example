# Настройки локального запуска через docker compose.
# Перед первым запуском: cp .env.example .env  (сам .env в git не коммитится)
#
# *_HOST - имя контейнера в docker-сети task-net, *_PORT - порт внутри контейнера.
# Наружу публикуется только API Gateway (8080); порты остальных сервисов
# закомментированы в docker-compose.yml.

# ---------- Auth Service ----------
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_PORT=8080

# ---------- Task Service ----------
TASK_SERVICE_HOST=task-service
TASK_SERVICE_PORT=8080
TASK_DB_HOST=task-db
TASK_DB_PORT=5432
TASK_DB_NAME=task_service
TASK_DB_USER=postgres
TASK_DB_PASSWORD=postgres

# ---------- Keycloak ----------
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
# Учётная запись администратора консоли Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_HOST=keycloak-db
KEYCLOAK_DB_PORT=5432
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=postgres
KEYCLOAK_DB_PASSWORD=postgres
REALM=demo
# Секрет клиента auth-service. Подставляется в keycloak/realm/demo-realm.json при импорте realm,
# поэтому после изменения нужен повторный импорт: docker compose down -v
KEYCLOAK_CLIENT_SECRET=auth-secret

# ---------- Kafka ----------
KAFKA_HOST=kafka
KAFKA_PORT=9092

# ---------- Accounting Service ----------
ACCOUNTING_SERVICE_HOST=accounting-service
ACCOUNTING_SERVICE_PORT=8080
ACCOUNTING_DB_HOST=accounting-db
ACCOUNTING_DB_NAME=accounting_service
ACCOUNTING_DB_PORT=5432
ACCOUNTING_DB_USER=postgres
ACCOUNTING_DB_PASSWORD=postgres
# Сумма выплаты за одну завершённую задачу
ACCOUNTING_PAYMENT_AMOUNT=1000.00
# Когда проверять, наступил ли день выплаты (Spring cron: сек мин час день месяц день_недели).
# Выплата идёт через одну пятницу, отсчёт от ACCOUNTING_PAYOUT_ANCHOR_DATE.
# Для ручной проверки: ACCOUNTING_PAYOUT_CRON=0 * * * * * и ACCOUNTING_PAYOUT_ANCHOR_DATE=<сегодня>
ACCOUNTING_PAYOUT_CRON=0 0 0 * * FRI
# Первая дата выплаты (yyyy-MM-dd). Пусто - ближайшая пятница после первого старта сервиса
ACCOUNTING_PAYOUT_ANCHOR_DATE=
# Отправка платежей в Kafka (outbox): сколько записей за раз и как часто, в секундах
ACCOUNTING_OUTBOX_BATCH_SIZE=100
ACCOUNTING_OUTBOX_INTERVAL_SEC=10

# ---------- Search Service ----------
SEARCH_SERVICE_HOST=search-service
SEARCH_SERVICE_PORT=8080
SEARCH_DB_HOST=search-db
SEARCH_DB_NAME=search_service
SEARCH_DB_PORT=5432
SEARCH_DB_USER=postgres
SEARCH_DB_PASSWORD=postgres

# ---------- Общее ----------
# Часовой пояс accounting-service: в нём считается "пятница 00:00" (в Docker по умолчанию UTC)
TZ=Asia/Yerevan
