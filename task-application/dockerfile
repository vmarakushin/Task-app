# ===== Stage 1: build =====
FROM gradle:8.7-jdk21 AS building_jar

WORKDIR /app

COPY . .

RUN gradle :task-application:bootJar --no-daemon


# ===== Stage 2: runtime =====
FROM eclipse-temurin:21-jdk-alpine

WORKDIR /app

COPY --from=building_jar /app/task-application/build/libs/*.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
