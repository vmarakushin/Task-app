# ===== Stage 1: build =====
# Тот же мажорный Gradle, что и в wrapper (8.14), с JDK 21
FROM gradle:8.14-jdk21-alpine AS build

WORKDIR /app

# Отдельный COPY на каждый путь, чтобы сохранить структуру папок (COPY a/x b/y ./
# сложил бы всё в одну папку). Слои этого этапа в итоговый образ не попадают.
# Файлы сборки нужны все: settings.gradle.kts подключает все модули,
# и Gradle должен суметь сконфигурировать проект целиком
COPY settings.gradle.kts build.gradle.kts ./
COPY event-contracts/build.gradle.kts event-contracts/
COPY task-service/build.gradle.kts task-service/
COPY auth-service/build.gradle.kts auth-service/
COPY accounting-service/build.gradle.kts accounting-service/
COPY search-service/build.gradle.kts search-service/
COPY api-gateway/build.gradle.kts api-gateway/

# Исходники только тех модулей, которые нужны этому сервису:
# изменения в других сервисах не сбрасывают кеш сборки этого
COPY event-contracts/src event-contracts/src
COPY task-service/src task-service/src

# Кеш зависимостей Gradle переживает пересборки (BuildKit cache mount):
# библиотеки не скачиваются заново при каждом изменении кода.
# sharing=locked: compose собирает образы параллельно, а два Gradle из разных
# контейнеров не могут одновременно работать с одним кешем (блокировка не видна
# между контейнерами). Сборки пользуются кешем по очереди.
RUN --mount=type=cache,target=/home/gradle/.gradle,sharing=locked \
    gradle :task-service:bootJar --no-daemon


# ===== Stage 2: runtime =====
# Для запуска нужен только JRE: образ меньше и в нём нет компилятора
FROM eclipse-temurin:21-jre-alpine

# Приложение не должно работать от root внутри контейнера
RUN addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=build /app/task-service/build/libs/*.jar app.jar

USER app

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]
