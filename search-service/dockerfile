# ===== Stage 1: build =====
FROM gradle:8.7-jdk21 AS building_jar

WORKDIR /app

COPY . .

RUN gradle :search-service:bootJar --no-daemon


# ===== Stage 2: runtime =====
FROM eclipse-temurin:21-jdk-alpine

WORKDIR /app

COPY --from=building_jar /app/search-service/build/libs/*.jar app.jar

EXPOSE 8083

ENTRYPOINT ["java", "-jar", "app.jar"]
